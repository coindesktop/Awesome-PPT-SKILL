{
  "name": "PPTKIT Studio",
  "version": "1.0.0",
  "canvas": {"width": 1280, "height": 720, "columns": 12, "margin": 64, "gutter": 24},
  "primitive": {
    "color-paper": "#F2F0E9", "color-white": "#FFFFFF", "color-ink": "#20221F",
    "color-muted": "#6D7169", "color-line": "#D5D8CF", "color-soft": "#E6E8E0",
    "color-orange": "#E64D2D", "color-mandarin": "#FF653B", "color-night": "#161817",
    "color-silver": "#B5BAB3", "color-teal": "#164F46", "color-mint": "#DDEBE3",
    "color-grid": "#DBE3DD", "color-navy": "#172F34", "color-fog": "#F5F7F3",
    "space-1": "8px", "space-2": "16px", "space-3": "24px", "space-4": "32px",
    "space-6": "48px", "space-8": "64px", "space-12": "96px",
    "font-sans": "'Pretendard', sans-serif", "weight-regular": "400", "weight-bold": "700",
    "size-caption": "14px", "size-label": "16px", "size-detail": "20px", "size-body": "26px",
    "size-subhead": "36px", "size-title": "54px", "size-display": "88px", "size-metric": "112px", "size-jumbo": "156px"
  },
  "semantic": {
    "surface": "{color-paper}", "ink": "{color-ink}", "muted": "{color-muted}",
    "accent": "{color-orange}", "on-accent": "{color-white}", "line": "{color-line}",
    "panel": "{color-soft}", "font": "{font-sans}", "margin": "{space-8}",
    "gutter": "{space-3}", "body-size": "{size-body}", "title-size": "{size-title}", "display-size": "{size-display}"
  },
  "component": {
    "cover-title-size": "{display-size}", "cover-title-leading": "1.12", "cover-title-tracking": "-2.5px",
    "section-title-size": "{title-size}", "section-title-leading": "1.18", "section-title-tracking": "-1.5px",
    "body-leading": "1.42", "body-tracking": "-0.35px", "label-size": "{size-label}",
    "label-tracking": "1px", "metric-size": "{size-metric}", "metric-tracking": "-4px",
    "caption-size": "{size-caption}", "rule-color": "{line}", "table-cell-pad": "{space-2}"
  },
  "modes": {
    "editorial": {"surface":"{color-paper}","ink":"{color-ink}","muted":"{color-muted}","accent":"{color-orange}","panel":"{color-soft}","line":"{color-line}"},
    "product": {"surface":"{color-night}","ink":"{color-white}","muted":"{color-silver}","accent":"{color-mandarin}","panel":"#262A27","line":"#454B45","display-size":"92px","body-size":"26px"},
    "strategy": {"surface":"{color-white}","ink":"{color-navy}","muted":"#61716B","accent":"{color-teal}","panel":"{color-fog}","line":"{color-grid}","display-size":"70px","title-size":"48px","body-size":"23px"}
  }
}
